# Independent secrets; NEVER reuse legacy secrets
DJANGO_SECRET_KEY=REPLACE_WITH_64_CHARACTER_RANDOM_STRING
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_NEW_FERNET_KEY
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
NOSALE_PUBLIC_BASE_URL=https://nosale.svdev.pro
DJANGO_CSRF_TRUSTED_ORIGINS=
TRUST_PROXY=0
SECURE_COOKIES=1
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SAAS_DB_NAME=mpnosale_saas
SAAS_DB_USER=mpnosale_saas
SAAS_DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
SAAS_DB_HOST=db
SAAS_DB_PORT=5432
SAAS_WB_NETWORK_ENABLED=0
# Enable user-requested read-only token validation independently of background WB access.
SAAS_WB_TOKEN_VALIDATION_ENABLED=0
SAAS_ACCESS_ENFORCED=1
REQUIRE_EMAIL_VERIFICATION=1
SAAS_PIN_AUTH_ENABLED=1
# Existing relay remains the default until the dedicated domain is configured.
# After REG.RU mailbox + DNS checks, switch to django.core.mail.backends.smtp.EmailBackend
# with SMTP_HOST=mail.hosting.reg.ru, SMTP_PORT=465, SMTP_USE_TLS=0,
# SMTP_USE_SSL=1, SMTP_USER=noreply@nosale.pro, SMTP_FROM=NoSale <noreply@nosale.pro>.
DJANGO_EMAIL_BACKEND=portal.email_backend.RelayEmailBackend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional alternative to SMTP_PASSWORD: protected file mounted into the container.
SMTP_PASSWORD_FILE=
SMTP_FROM=MP NoSale <noreply@svdev.pro>
MAIL_RELAY_URL=https://mail.beclients.ru/svdev-relay.php
MAIL_RELAY_TOKEN=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT=12
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:notifications@svdev.pro

# Tochka acquiring, same one-time payment model as MiniBook, but SEPARATE
# NoSale merchant and public bank webhook verification. All disabled until
# commercial price, merchant contract and receipt/fiscalization are approved.
NOSALE_TOCHKA_ENABLED=0
NOSALE_MONTHLY_PRICE_RUB=0
# Optional override for existing Standard price; if empty, legacy MONTHLY_PRICE above is used.
NOSALE_STANDARD_MONTHLY_PRICE_RUB=
# Leave Smart at 0 until its offer, merchant and fiscal receipt setup are approved.
NOSALE_SMART_MONTHLY_PRICE_RUB=0
# Private, exact e-mail for the already registered, verified owner PIN account.
# Does not create a user or auto-promote anyone; use explicit operator command.
NOSALE_OWNER_EMAIL=
# AI remains OFF unless owner enables it, selects a published gateway model,
# enrolls a NoSale-only service token and approves a monthly budget.
NOSALE_AI_GATEWAY_URL=
NOSALE_AI_SERVICE_TOKEN=
NOSALE_AI_RESERVE_KOPEKS_PER_CALL=100
NOSALE_FISCALIZATION_CONFIRMED=0
NOSALE_TOCHKA_JWT_TOKEN=
NOSALE_TOCHKA_CUSTOMER_CODE=
NOSALE_TOCHKA_MERCHANT_ID=
NOSALE_TOCHKA_WEBHOOK_JWK_JSON=
NOSALE_TOCHKA_API_BASE=https://enter.tochka.com/uapi

# Separate NoSale Yandex Metrica counter. Leave empty until the owner creates one.
NOSALE_YM_COUNTER_ID=
NOSALE_YANDEX_VERIFICATION=
NOSALE_GOOGLE_VERIFICATION=
