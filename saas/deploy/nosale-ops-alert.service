[Unit]
Description=NoSale production workers, web and offsite backup health alert
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/mpnosale-saas/source/saas/deploy/nosale-ops-alert.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
