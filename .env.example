# Copy this file to .env and edit technical settings.
# Marketplace API tokens are entered only on the site:
# "Маркетплейс и автоцикл".

# READ_ONLY: no real marketplace changes.
# LIVE: automatic and manual discount reset sends real API tasks.
APP_MODE=READ_ONLY
LIVE_MAX_FIXES=5
AUTO_CHECK_ENABLED=0
CHECK_INTERVAL_SECONDS=300

# Change this key before production use.
ENCRYPTION_KEY=change_me_to_random_long_string
DATABASE_PATH=data/app.db

# Optional email notifications. For Gmail use an app password, not the regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
